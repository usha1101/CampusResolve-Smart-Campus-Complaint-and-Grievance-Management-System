# Application Settings
ENVIRONMENT=development
PORT=8000
APP_NAME="CampusResolve API"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database
# For SQLite local dev: sqlite:///./campusresolve.db
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/campusresolve
DATABASE_URL=sqlite:///./campusresolve.db

# Authentication & JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Integration (Google Gemini)
GEMINI_API_KEY=

# Supabase Storage (Complaint Attachments)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=complaint-attachments
